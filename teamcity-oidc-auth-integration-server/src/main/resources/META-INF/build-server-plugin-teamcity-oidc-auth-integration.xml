<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       default-autowire="constructor">

  <bean class="org.jetbrains.teamcity.oidc.config.OidcPluginSettingsStorageImpl" init-method="init"/>
  <bean class="org.jetbrains.teamcity.oidc.oidc.OidcClient"/>
  <bean id="systemClock" class="java.time.Clock" factory-method="systemUTC"/>
  <bean class="org.jetbrains.teamcity.oidc.oidc.OidcIdTokenValidator"/>
  <bean class="org.jetbrains.teamcity.oidc.auth.OidcStateManager"/>
  <bean class="org.jetbrains.teamcity.oidc.auth.OidcAuthenticationScheme"/>
  <bean class="org.jetbrains.teamcity.oidc.auth.OidcTokenIntrospectionInterceptor"/>
  <bean class="org.jetbrains.teamcity.oidc.web.OidcLoginController"/>
  <bean class="org.jetbrains.teamcity.oidc.web.OidcCallbackController"/>
  <bean class="org.jetbrains.teamcity.oidc.web.OidcBackChannelLogoutController"/>
  <bean class="org.jetbrains.teamcity.oidc.web.OidcLoginPageExtension"/>

</beans>
